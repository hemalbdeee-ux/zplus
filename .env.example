# Public domain of the web app (Traefik routes it and gets the TLS certificate)
WBD_DOMAIN=zplus.ai
# Optional: require this code for a full restore (use a long random value). Empty = anyone can run one.
# 5 wrong codes from one address (IPv6: one /64) in an hour block its full restores for that hour.
WBD_ACCESS_CODE=
# Jobs running at the same time, each in its own process. archive.org blocks fast clients; keep this at 1 or 2.
# Snapshot checks and demos get one more slot, so they never wait for a full restore.
WBD_WORKERS=1
# Days to keep finished jobs and their ZIP files
WBD_RETENTION_DAYS=7
# Snapshot checks each address may start per hour, and restores (demo or full) per day
WBD_SCAN_LIMIT=30
WBD_RESTORE_LIMIT=10
# Resource caps for the container, so restores cannot slow down other sites on the same server
WBD_CPUS=1.0
WBD_MEMORY=1g
