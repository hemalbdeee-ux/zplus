# Public domain of the web app (Traefik routes it and gets the TLS certificate)
WBD_DOMAIN=waybackdownloader.example
# Code customers need for a full restore (demo restores are free). Empty = only demos.
WBD_ACCESS_CODE=
# Restore jobs running at the same time. archive.org blocks fast clients; keep this at 1 or 2.
WBD_WORKERS=1
# Days to keep finished jobs and their ZIP files
WBD_RETENTION_DAYS=7
