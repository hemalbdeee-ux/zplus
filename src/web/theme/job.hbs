<section class="page-head page-head-tight">
    <div class="wrap">
        <p class="eyebrow">{{#if job.isScan}}Snapshot check{{else}}{{#if job.demo}}Demo restore{{else}}Full restore{{/if}}{{/if}}</p>
        <h1 class="domain-title">{{job.domain}}</h1>
    </div>
</section>

<section class="band band-tight" data-job="{{job.id}}" data-status="{{job.status}}">
    <div class="wrap">
    {{#unless job.isScan}}<div class="run{{#if job.preview}} run-split{{/if}}"><div class="run-main">{{/unless}}

    {{#if job.active}}
        <div class="status-card" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <div class="status-text">
                <h2>{{#if job.isScan}}Checking the archive{{else}}Restoring the site{{/if}}</h2>
                <p data-field="position">{{#if job.position}}Waiting in line, position {{job.position}}.{{/if}}</p>
                <p class="mono status-message" data-field="message">{{job.message}}</p>
                {{#unless job.isScan}}<p data-field="counts">{{number job.done}} URLs done, {{number job.queued}} waiting</p>{{/unless}}
                <p class="muted">We pause between requests so archive.org does not block us. A snapshot check takes about a minute; a large site can take hours. You can close this page and open the same link later.</p>
            </div>
        </div>
    {{/if}}

    {{#if (eq job.status "failed")}}
        <div class="notice notice-bad" role="alert">
            <h2>This did not work</h2>
            <p>{{job.error}}</p>
            {{#if job.canRetry}}
            <form method="post" action="/job/{{job.id}}/retry"><button class="btn" type="submit">Try again</button></form>
            <p class="form-note">The restore continues where it stopped: what it has downloaded is kept.</p>
            {{else}}{{#if job.recheck}}{{> recheck domain=job.domain}}{{/if}}{{/if}}
            {{#if job.retriesUsed}}<p>This restore has already been run again {{job.retriesUsed}} times, as often as one restore can be, so it cannot continue here. A new restore from the snapshots starts over.</p>{{/if}}
            <p>{{#if job.parentId}}<a href="/job/{{job.parentId}}/">Back to the snapshots</a>{{else}}<a href="/restore/">Try another domain</a>{{/if}}</p>
        </div>
    {{/if}}

    {{#if (eq job.status "done")}}
        {{#if job.isScan}}
            {{#if job.health.months.length}}
            <div class="split split-job">
                <div class="panel panel-form job-form">
                    {{#unless job.choices.length}}{{#if job.refusal}}
                    <div class="notice notice-bad"><h2>No healthy snapshot found yet</h2><p>None of the homepages we could check looks like a real website, but archive.org refused {{job.refusal.refused}} of the {{job.refusal.checked}} captures we asked for{{#if job.refusal.reason}} ({{job.refusal.reason}}){{/if}}. The site may be among those, so checking again later may find it.</p>{{> recheck domain=job.domain}}</div>
                    {{else}}
                    <div class="notice notice-bad"><h2>No healthy snapshot</h2><p>None of the archived homepages looks like a real website: they are parking pages, errors or spam. If you know a date when the site was still fine, you can restore that date below.</p></div>
                    {{/if}}{{/unless}}
                    <h2>{{#if job.choices.length}}Restore{{else}}Restore a date you choose{{/if}}</h2>
                    <form class="stack restore-form" method="post" action="/job/{{job.id}}/restore">
                        {{#if job.choices.length}}
                        <label for="target">Snapshot</label>
                        <select id="target" name="target">
                            {{#each job.choices}}<option value="{{timestamp}}"{{#if selected}} selected{{/if}}>{{ts timestamp}} · score {{score}}{{#if last}} · last good{{/if}}</option>{{/each}}
                        </select>
                        {{/if}}
                        <label for="custom">{{#if job.choices.length}}Or your own snapshot <span class="muted">(optional)</span>{{else}}Your snapshot{{/if}}</label>
                        <input id="custom" name="custom" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="2000" placeholder="2015-06-12 or a web.archive.org link" value="{{job.custom}}" aria-describedby="custom-note custom-hint"{{#unless job.choices.length}} required{{/unless}}{{#if job.customError}} aria-invalid="true"{{/if}}>
                        {{#if job.customError}}
                        <p class="form-hint bad" id="custom-hint" data-hint data-refused role="alert">{{job.customError}}</p>
                        {{else}}
                        <p class="form-hint" id="custom-hint" data-hint aria-live="polite" hidden></p>
                        {{/if}}
                        <p class="form-note" id="custom-note">A date, or the link of a capture from the <a href="{{job.archive}}/web/*/{{job.domain}}" target="_blank" rel="noopener noreferrer">Wayback Machine calendar</a><span data-tl-tip hidden>; or click a month in the timeline</span>.{{#if job.choices.length}} It is used instead of the list.{{/if}}</p>
                        <fieldset>
                            <legend>What to restore</legend>
                            <label class="radio"><input type="radio" name="mode" value="demo"{{#unless job.full}} checked{{/unless}}> <span><b>Demo</b>: the homepage and 3 more pages</span></label>
                            <label class="radio"><input type="radio" name="mode" value="full"{{#if job.full}} checked{{/if}}> <span><b>Full site</b>: every archived URL of the chosen period, up to 20,000</span></label>
                            {{#if job.codeRequired}}
                            <label for="code">Access code for a full restore</label>
                            <input id="code" name="code" type="password" autocomplete="off" aria-describedby="code-note">
                            <p class="form-note" id="code-note">Not needed for a demo. After {{job.codeTries}} wrong codes, full restores from your address are blocked for an hour.</p>
                            {{/if}}
                        </fieldset>
                        {{#if formError}}<p class="form-error" role="alert">{{formError}}</p>{{/if}}
                        <button class="btn" type="submit">Restore this snapshot</button>
                    </form>
                </div>
                <div class="panel job-health">
                    <h2>Homepage health by month</h2>
                    {{> timeline rows=job.rows}}
                    {{#if job.health.lastGood}}
                    <p>Last good snapshot: <b class="mono">{{job.health.lastGood.timestamp}}</b> (score {{job.health.lastGood.score}}/100).
                    Pages are taken from {{#if job.health.window.from}}<b>{{ts job.health.window.from}}</b>{{else}}the first capture{{/if}} to {{#if job.health.window.to}}<b>{{ts job.health.window.to}}</b>{{else}}the last capture{{/if}}. Host: <span class="mono">{{job.health.host}}</span>.</p>
                    {{/if}}
                </div>
                {{#if job.preview}}
                <div class="job-preview">{{> preview p=job.preview archive=job.archive host=job.health.host domain=job.domain heading="How the site looked" windowTo=job.health.window.to lastGood=job.health.lastGood.timestamp}}</div>
                {{/if}}
            </div>
            {{#if job.probed.length}}
            <details class="probes">
                <summary>What we checked ({{job.probed.length}} homepage captures)</summary>
                <div class="tbl"><table>
                    <thead><tr><th>Month</th><th>Score</th><th>Result</th><th>Why</th></tr></thead>
                    <tbody>{{#each job.probed}}<tr><td class="mono">{{ts timestamp}}</td><td>{{score}}</td><td><span class="pill {{verdict}}">{{verdict}}</span></td><td>{{#each reasons}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</td></tr>{{/each}}</tbody>
                </table></div>
            </details>
            {{/if}}
            {{else}}
            <div class="notice notice-bad"><h2>Not in the archive</h2><p>The Wayback Machine has no captures of {{job.domain}}. Check the spelling, or try the domain with or without "www".</p><p><a href="/restore/">Try another domain</a></p></div>
            {{/if}}
        {{else}}
            <div class="result">
                <h2>The site is ready</h2>
                <p>Restored from the snapshot of <b>{{ts job.report.target}}</b> for <span class="mono">{{job.report.siteUrl}}</span>. On Apache, LiteSpeed and nginx hosting every original URL works at the same address.</p>
                <dl class="stats">
                    <div><dt>Pages</dt><dd>{{number job.report.counts.pages}}</dd></div>
                    <div><dt>Blog posts</dt><dd>{{number job.report.counts.posts}}</dd></div>
                    <div><dt>Files</dt><dd>{{number job.report.counts.files}}</dd><dd class="muted">{{mb job.report.counts.bytes}}</dd></div>
                    <div><dt>Original redirects</dt><dd>{{number job.report.counts.redirects}}</dd></div>
                    <div><dt>Odd URLs kept</dt><dd>{{number job.report.counts.rewrites}}</dd></div>
                    <div><dt>Not in the archive</dt><dd>{{number job.report.counts.missing}}</dd></div>
                </dl>
                <p class="actions">{{#if job.hasZip}}<a class="btn" href="/job/{{job.id}}/download">Download ZIP</a>{{/if}} <a class="btn btn-ghost" href="/job/{{job.id}}/report">Open the report</a></p>
                {{#if job.demo}}<p class="notice">This demo contains the homepage and the first pages it links to. A {{#if job.parentId}}<a href="/job/{{job.parentId}}/?snapshot={{job.target}}&amp;mode=full">full restore</a>{{else}}full restore{{/if}} downloads every archived URL of the healthy period.</p>{{/if}}
                {{#each job.report.warnings}}<p class="notice">{{this}}</p>{{/each}}
                <h3>Put it online</h3>
                <ol class="howto">
                    <li>Unzip the file. The <code>site</code> folder is the website.</li>
                    <li>Upload the contents of <code>site</code>, including the hidden <code>.htaccess</code>, to your web root (for example <code>public_html</code>).</li>
                    <li>On nginx, use <code>server/nginx.conf</code> instead of <code>.htaccess</code>.</li>
                    <li>Point the domain at the hosting, then open a few old URLs from the report to check them.</li>
                </ol>
            </div>
        {{/if}}
    {{/if}}
    {{#unless job.isScan}}</div>{{#if job.preview}}{{> preview p=job.preview archive=job.archive host=job.previewHost domain=job.domain heading=job.previewHeading}}{{/if}}</div>{{/unless}}
    </div>
</section>
