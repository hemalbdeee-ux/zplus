{
  "name": "wayback-downloader",
  "version": "0.1.0",
  "private": true,
  "description": "Recover expired websites from the Wayback Machine and deliver them as Ghost-style, SEO-ready static sites.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "wbd": "src/cli.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/web/server.ts",
    "demo": "node --disable-warning=ExperimentalWarning test/demo-server.ts",
    "wbd": "node src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "express": "5.2.1",
    "handlebars": "4.7.10",
    "marked": "18.0.14",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/yazl": "3.3.1",
    "domhandler": "5.0.3",
    "typescript": "6.0.3"
  }
}
